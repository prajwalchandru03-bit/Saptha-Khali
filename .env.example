# ==============================================================================
# TruthLens: Multimodal Digital Forensics & Deepfake Detection Backend
# Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Required for AI Correlator)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model to use for forensic correlation & report synthesis
GEMINI_MODEL=gemini-3.8-flash

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Device configuration: "cpu", "cuda", or "mps"
DEVICE=cpu

# Directory Paths
OUTPUT_DIR=./truthlens_workspace
TEMP_DIR=./tmp

# Path to ffmpeg binary (if not located in standard system PATH)
# On Windows, e.g., C:/ffmpeg/bin/ffmpeg.exe or leave as 'ffmpeg'
FFMPEG_PATH=ffmpeg

# Max video keyframes sampled for fast CPU analysis on Instagram Reels / short-form videos
MAX_VIDEO_FRAMES_ANALYSIS=10
